# ── 공통 ─────────────────────────────────────────
.DS_Store
*.log
logs/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── 비밀값 ───────────────────────────────────────
# 환경변수, mTLS 인증서/개인키, 운영 광고 ID 는 저장소에 올리지 않는다
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
certs/
secrets/

# ── frontend ────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
# ait build 산출물
*.ait
.vite/
coverage/

# ── backend ─────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
htmlcov/
.coverage
.coverage.*

# ── 로컬 작업 파일 ───────────────────────────────
.claude/settings.local.json

# ── 제품 기획 원문 ────────────────────────────────
# 레포가 public 이라 가격·지표가 담긴 PRD 원문과 시안은 올리지 않는다.
# 정본은 레포 밖 개인 노트에 있고(경로는 인계 문서), 레포에는 그 결정의 결과만 둔다.
docs/PRD*
docs/design/
# 시안 html 을 코드 옆에 복사해 두는 일이 잦다. 어느 폴더에 있든 막는다.
**/mockup*.html
**/*.dc.html

# ── 검증 캡처 ────────────────────────────────────
# 화면을 찍은 png 가 저장소에 쌓이지 않게 한다. 아이콘 자산만 예외다.
*.png
!frontend/public/icons/**/*.png

# 화면 동작 영상. 용량이 크고 레포에 둘 것이 아니다.
# 만드는 방법은 frontend/e2e/README.md 「데모 녹화」 절에 있다.
frontend/demo-videos/

# 검증용으로 찍어 둔 임시 스크린샷 (public 레포에 두지 않는다)
frontend/plan_check.png
