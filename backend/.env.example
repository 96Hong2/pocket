# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# local | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://pocket:pocket@localhost:5432/pocket

# 쉼표로 구분한다. 비워 두면 코드의 기본 목록을 쓴다.
CORS_ORIGINS=https://pocket.web.tossmini.com,https://pocket.private-web.tossmini.com,https://pocket.apps.tossmini.com,https://pocket.private-apps.tossmini.com,http://localhost:5173

TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im

# 익명 식별키 검증용 mTLS 인증서 경로. 인증서 파일 자체는 저장소에 넣지 않는다.
TOSS_MTLS_CERT_PATH=
TOSS_MTLS_KEY_PATH=

# 인증서 없이 로컬에서 개발할 때만 true. ENVIRONMENT=prod 와 함께 쓰면 기동에 실패한다.
ALLOW_UNVERIFIED_ANON_KEY=false

# 개발·테스트용 공식 배너 광고 ID. 운영 ID 는 배포 환경변수로만 넣는다.
ADS_BANNER_AD_GROUP_ID=ait-ad-test-banner-id
