# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# local | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://pocket:pocket@localhost:5434/pocket

# 쉼표로 구분한다. 비워 두면 코드의 기본 목록을 쓴다.
CORS_ORIGINS=https://pocket-ledger.web.tossmini.com,https://pocket-ledger.private-web.tossmini.com,https://pocket-ledger.apps.tossmini.com,https://pocket-ledger.private-apps.tossmini.com,http://localhost:5173

TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im

# 익명 식별키 검증용 mTLS 인증서 경로. 인증서 파일 자체는 저장소에 넣지 않는다.
TOSS_MTLS_CERT_PATH=
TOSS_MTLS_KEY_PATH=

# 인증서 없이 로컬에서 개발할 때만 true. ENVIRONMENT 가 local 이 아니면 기동에 실패한다.
ALLOW_UNVERIFIED_ANON_KEY=false

# 끝난 기간의 예산 쓰기를 열어 둔다. 화면 검증 스택만 켠다.
# 자동 이어쓰기를 화면으로 보려면 지난달 예산이 이미 있어야 하는데 만들 길이 이것뿐이다.
# ENVIRONMENT 가 local 이 아니면 기동에 실패한다.
ALLOW_PAST_PERIOD_BUDGET_WRITE=false

# 줄글·사진을 읽는 모델. stub | gemini | openai
# stub 은 규칙 파서라 사진을 읽지 않는다. 실제 인식은 gemini 로 바꾸고 아래 키를 넣는다.
# 검증(pytest·e2e)은 이 값과 무관하게 늘 스텁으로 돈다.
LLM_PROVIDER=stub
# https://aistudio.google.com/apikey 에서 발급. 유료 등급(결제 계정 연결) 프로젝트의 키여야
# 보낸 입력을 Google 이 제품 개선에 쓰지 않는다. docs/SECRETS.md §4.
GEMINI_API_KEY=
# https://platform.openai.com/api-keys 에서 발급. LLM_PROVIDER=openai 일 때만 읽는다.
OPENAI_API_KEY=
# 비우면 provider 기본 모델(gemini-3.6-flash / gpt-5-mini).
LLM_MODEL=
# provider 응답을 기다리는 시간(초). 한 번 재시도하므로 최악은 두 배다.
LLM_TIMEOUT_SECONDS=20

# 광고 ID 는 프론트 빌드 환경변수(VITE_AD_GROUP_ID)다. 백엔드는 쓰지 않는다.
