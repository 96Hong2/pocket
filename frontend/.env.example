# 이 파일을 .env.local 로 복사해서 값을 채운다. 실제 값은 저장소에 올리지 않는다.

# 백엔드 API 절대주소. 끝에 / 를 붙이지 않는다.
#
# 프록시로 같은 출처인 척하지 않는다. 그러면 로컬에서 CORS 가 한 번도 돌지 않아
# 배포하고 나서야 처음 막힌다.
#
# 비워 두면 개발(npm run dev)에서는 http://localhost:8000 으로 간다. `make dev-back` 이 띄우는 주소다.
# e2e 는 playwright.config.ts 가 자기 백엔드 주소를 직접 넣어 준다.
# 운영 빌드에서 비어 있으면 요청할 때 오류로 드러난다(화면이 하얗게 죽지는 않는다).
VITE_API_BASE_URL=

# 운영 배너 광고 그룹 ID. 비워 두면 개발에서는 공식 테스트 배너로 뜨고,
# 운영 빌드에서는 슬롯이 아예 접힌다. 실제 값은 저장소에 올리지 않는다.
VITE_AD_GROUP_ID=

# 운영 전면 광고 그룹 ID. 월말 결산·자산 화면·리포트 월 이동 앞에 한 편 띄운다(ADR-0023).
# 비워 두면 개발에서는 공식 테스트 전면 광고로 뜨고, 운영 빌드에서는 광고 없이 바로 열린다.
VITE_AD_FULLSCREEN_GROUP_ID=

# 운영 리워드 광고 그룹 ID. 「얼마로 할지 모르겠어요」 로 생활비 계산기를 여는 자리에 쓴다.
# 전면 그룹과 **다른 그룹**이어야 한다. 콘솔에서 리워드형으로 만든 것만 보상 이벤트를 준다(ADR-0024).
VITE_AD_REWARDED_GROUP_ID=

# 토스 콘솔 스마트발송 템플릿 코드. 알림 동의 화면을 띄울 때 필요하다.
#
# 비워 두면 개발(npm run dev)에서는 이미 동의한 것으로 보고 화면을 끝까지 눌러 볼 수 있고,
# 운영 빌드에서는 알림을 못 쓰는 기능으로 다룬다(토글 대신 안내가 뜬다).
VITE_NOTIFICATION_TEMPLATE_CODE=
